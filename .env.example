DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_API_KEY=你的 Qwen / DashScope API Key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 用于整篇音频时间戳对齐：TTS 音频临时上传到 OSS，再交给 Qwen ASR 文件转写
DASHSCOPE_API_KEY=你的 DashScope API Key
QWEN_ASR_MODEL=qwen3-asr-flash-filetrans
OSS_ACCESS_KEY_ID=你的 OSS AccessKey ID
OSS_ACCESS_KEY_SECRET=你的 OSS AccessKey Secret
OSS_BUCKET=你的 Bucket 名称
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_TEMP_PREFIX=asr-temp/

# MiniMax TTS（可选）：AI 朗读切换为 MiniMax 时使用，整篇一次合成、自带句级时间轴，无需 OSS/ASR
MINIMAX_API_KEY=你的 MiniMax API Key
MINIMAX_GROUP_ID=你的 MiniMax GroupId
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TTS_MODEL=speech-2.6-hd
MINIMAX_TTS_VOICE=English_Graceful_Lady
MINIMAX_TTS_SPEED=1.0
MINIMAX_LANGUAGE_BOOST=English
